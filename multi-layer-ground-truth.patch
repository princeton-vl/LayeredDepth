diff --git a/intern/cycles/kernel/film/multilayer_passes.h b/intern/cycles/kernel/film/multilayer_passes.h
new file mode 100644
index 0000000..fc90767
--- /dev/null
+++ b/intern/cycles/kernel/film/multilayer_passes.h
@@ -0,0 +1,91 @@
+#pragma once
+#include "kernel/geom/geom.h"
+#include "kernel/film/write.h"
+
+CCL_NAMESPACE_BEGIN
+
+ccl_device_inline void film_write_multilayer_passes(KernelGlobals kg,
+    IntegratorState state,
+    ccl_private const ShaderData *sd,
+    ccl_global float *ccl_restrict render_buffer)
+{
+    const uint32_t path_flag = INTEGRATOR_STATE(state, path, flag);
+    /* Skip implicitly transparent surfaces. */
+    if (sd->flag & SD_HAS_ONLY_VOLUME) {
+        return;
+    }
+
+    /* Don't write denoising passes for paths that were split off for shadow catchers
+    * to avoid double-counting. */
+    if (path_flag & PATH_RAY_SHADOW_CATCHER_PASS) {
+        return;
+    }
+
+    ccl_global float *buffer = film_pass_pixel_render_buffer(kg, state, render_buffer);
+
+      if (kernel_data.film.pass_layered_object_id_0 != PASS_UNUSED) {
+        const float id = object_pass_id(kg, sd->object);
+        const int bounce = (int)INTEGRATOR_STATE(state, path, bounce);
+        switch (bounce) {
+          case 0: film_write_pass_float(buffer + kernel_data.film.pass_layered_object_id_0, id); break;
+          case 1: film_write_pass_float(buffer + kernel_data.film.pass_layered_object_id_1, id); break;
+          case 2: film_write_pass_float(buffer + kernel_data.film.pass_layered_object_id_2, id); break;
+          case 3: film_write_pass_float(buffer + kernel_data.film.pass_layered_object_id_3, id); break;
+          case 4: film_write_pass_float(buffer + kernel_data.film.pass_layered_object_id_4, id); break;
+          case 5: film_write_pass_float(buffer + kernel_data.film.pass_layered_object_id_5, id); break;
+          case 6: film_write_pass_float(buffer + kernel_data.film.pass_layered_object_id_6, id); break;
+          case 7: film_write_pass_float(buffer + kernel_data.film.pass_layered_object_id_7, id); break;
+          default: break; /* Ignore any additional bounces. */
+        }
+      }
+
+      if (kernel_data.film.pass_layered_material_id_0 != PASS_UNUSED) {
+        const float id = shader_pass_id(kg, sd);
+        const int bounce = (int)INTEGRATOR_STATE(state, path, bounce);
+        switch (bounce) {
+          case 0: film_write_pass_float(buffer + kernel_data.film.pass_layered_material_id_0, id); break;
+          case 1: film_write_pass_float(buffer + kernel_data.film.pass_layered_material_id_1, id); break;
+          case 2: film_write_pass_float(buffer + kernel_data.film.pass_layered_material_id_2, id); break;
+          case 3: film_write_pass_float(buffer + kernel_data.film.pass_layered_material_id_3, id); break;
+          case 4: film_write_pass_float(buffer + kernel_data.film.pass_layered_material_id_4, id); break;
+          case 5: film_write_pass_float(buffer + kernel_data.film.pass_layered_material_id_5, id); break;
+          case 6: film_write_pass_float(buffer + kernel_data.film.pass_layered_material_id_6, id); break;
+          case 7: film_write_pass_float(buffer + kernel_data.film.pass_layered_material_id_7, id); break;
+          default: break; /* Ignore any additional bounces. */
+        }
+      }
+  
+      if (kernel_data.film.pass_layered_depth_0 != PASS_UNUSED) {
+        const float depth = camera_z_depth(kg, sd->P);
+        const int bounce = (int)INTEGRATOR_STATE(state, path, bounce);
+        switch (bounce) {
+          case 0: film_write_pass_float(buffer + kernel_data.film.pass_layered_depth_0, depth); break;
+          case 1: film_write_pass_float(buffer + kernel_data.film.pass_layered_depth_1, depth); break;
+          case 2: film_write_pass_float(buffer + kernel_data.film.pass_layered_depth_2, depth); break;
+          case 3: film_write_pass_float(buffer + kernel_data.film.pass_layered_depth_3, depth); break;
+          case 4: film_write_pass_float(buffer + kernel_data.film.pass_layered_depth_4, depth); break;
+          case 5: film_write_pass_float(buffer + kernel_data.film.pass_layered_depth_5, depth); break;
+          case 6: film_write_pass_float(buffer + kernel_data.film.pass_layered_depth_6, depth); break;
+          case 7: film_write_pass_float(buffer + kernel_data.film.pass_layered_depth_7, depth); break;
+          default: break; /* Ignore any additional bounces. */
+        }
+      }
+
+    if (kernel_data.film.pass_layered_normal_0 != PASS_UNUSED) {
+        const int bounce = (int)INTEGRATOR_STATE(state, path, bounce);
+        const float3 denoising_normal = surface_shader_average_normal(kg, sd);
+        switch (bounce) {
+            case 0: film_write_pass_float3(buffer + kernel_data.film.pass_layered_normal_0, denoising_normal); break;
+            case 1: film_write_pass_float3(buffer + kernel_data.film.pass_layered_normal_1, denoising_normal); break;
+            case 2: film_write_pass_float3(buffer + kernel_data.film.pass_layered_normal_2, denoising_normal); break;
+            case 3: film_write_pass_float3(buffer + kernel_data.film.pass_layered_normal_3, denoising_normal); break;
+            case 4: film_write_pass_float3(buffer + kernel_data.film.pass_layered_normal_4, denoising_normal); break;
+            case 5: film_write_pass_float3(buffer + kernel_data.film.pass_layered_normal_5, denoising_normal); break;
+            case 6: film_write_pass_float3(buffer + kernel_data.film.pass_layered_normal_6, denoising_normal); break;
+            case 7: film_write_pass_float3(buffer + kernel_data.film.pass_layered_normal_7, denoising_normal); break;
+            default: break; /* Ignore any additional bounces. */
+        }
+    }
+}
+
+CCL_NAMESPACE_END
